# Build context is the REPO ROOT - same reason as Dockerfile.server (npm
# workspaces need the root manifests to resolve @ae/shared).
FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/client/package.json packages/client/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/server/package.json packages/server/package.json
RUN npm ci

COPY . .

# Vite inlines this into the built JS at BUILD time (see
# packages/client/src/constants.js's SERVER_WS_URL) - point it at the SAME
# host:port the page itself is served on, plus the /ws path nginx.conf
# reverse-proxies to the server container (see that file) - there is no
# longer a separate exposed port for the game server to point at directly.
# Pass it with --build-arg (see the docker build command below); it
# silently falls back to ws://localhost:8443/ws if omitted.
ARG VITE_SERVER_WS_URL
ENV VITE_SERVER_WS_URL=$VITE_SERVER_WS_URL

WORKDIR /app/packages/client
RUN npm run build

# --- serve stage: just the static output, no node/npm in the final image ---
FROM nginx:alpine
COPY --from=build /app/packages/client/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
