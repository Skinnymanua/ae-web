@@ -0,0 +1,24 @@
+{
+  "_source": "project_aeii android/assets/lang/en_US.dat (UNIT_NAME_*, UNIT_DESCRIPTION_*)",
+  "units": [
+    { "index": 0, "name": "Soldier", "description": "Soldiers are all-round solid fighters, and they can capture or repair villages to give you benefits." },
+    { "index": 1, "name": "Archer", "description": "With their powerful bows archers can attack from a distance and are especially efficient against airborne enemies." },
+    { "index": 2, "name": "Aqua Elemental", "description": "Water elementals are friends of the water. When in water, they become much more stronger." },
+    { "index": 3, "name": "Sorceress", "description": "They are skilled in the use of necromancy. Sorceresses are weak in melee combat but they can summon skeletons from the dead to aid you in the battle." },
+    { "index": 4, "name": "Spirit", "description": "These mystical beings of pure light have an aura that can remove negative effects from your allies and heal them a little bit." },
+    { "index": 5, "name": "Wolf", "description": "Wolves are fearsome hunters with very high motility. They travel very fast on land and kill enemies with their poisonous bites." },
+    { "index": 6, "name": "Golem", "description": "Golems are ancient beings, incredibly strong in physical defence and are even stronger when in the mountains." },
+    { "index": 7, "name": "Catapult", "description": "Catapults blaze a trail of destruction with their enormous attack range. However they have very low motility." },
+    { "index": 8, "name": "Dragon", "description": "These massive flying beasts have ruled the sky since ancient times. They have very high motility and deadly melee attacks." },
+    { "index": 9, "name": "Commander", "description": "Commander is the heart of an army. He has quite strong battle skills and can capture enemy castles." },
+    { "index": 10, "name": "Skeleton", "description": "Skeletons are undead beings summoned by necromancers. They are not very strong but have poisonous attacks." },
+    { "index": 11, "name": "Crystal", "description": "" },
+    { "index": 12, "name": "Paladin", "description": "Paladins are holy armies who are skilled at healing and can also capture villages like soldiers do." },
+    { "index": 13, "name": "Berserker", "description": "Berserkers are born fighters. The more enemies are around them the stronger they become." },
+    { "index": 14, "name": "Ghost", "description": "Ghosts are mystical undead beings. They float above the ground and can blind enemies with their attacks." },
+    { "index": 15, "name": "Black Mage", "description": "Black mages are skilled at using dark magic. Their attacks are always powerful against those with low magic defence." },
+    { "index": 16, "name": "Wolfarcher", "description": "Wolfarchers are high mobility version of archers. They can strike almost anywhere you want them to attack." },
+    { "index": 17, "name": "Ice Elemental", "description": "Ice elementals are mystical beings formed by pure ice. It seems they can fight well both in water and on land." },
+    { "index": 18, "name": "Slime", "description": "Mystic creatures. It seems their soft body can absorb a lot of damages." }
+  ]
+}
