# Build context is the REPO ROOT (not packages/server) - this is an npm
# workspaces monorepo, so `npm ci` needs the root package.json/lockfile plus
# every workspace's own package.json to resolve @ae/shared correctly. See
# the "docker build" command below for the -f/context pairing this expects.
FROM node:22-alpine

WORKDIR /app

# Copy just the manifests first so `npm ci` is cached across rebuilds and
# only re-runs when a dependency actually changes, not on every source edit.
COPY package.json package-lock.json ./
COPY packages/server/package.json packages/server/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/client/package.json packages/client/package.json
RUN npm ci

# Now bring in the actual source (node_modules and packages/server/sessions
# are excluded via .dockerignore, so this doesn't clobber what npm ci just
# installed or ship stale session files baked into the image).
COPY . .

# Session files (see packages/server/src/sessions.js) - mounted as a volume
# in docker-compose.yml so in-progress games survive a container restart,
# not just a client refresh.
ENV SESSIONS_DIR=/data/sessions
RUN mkdir -p /data/sessions

WORKDIR /app/packages/server
EXPOSE 8080
CMD ["node", "src/index.js"]
